# Verifica los mandatos AP2 antes de entregar el token y firma los recibos de pago.
# PAYMENT_AP2_REQUIRED=true
# PAYMENT_AP2_AGENT_JWK_JSON={"kty":"EC","crv":"P-256","x":"...","y":"..."}
# PAYMENT_AP2_MERCHANT_JWK_JSON={"kty":"EC","crv":"P-256","x":"...","y":"..."}
# PAYMENT_AP2_MERCHANT_ISSUER=https://merchant.example.test
# PAYMENT_AP2_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Reloj fijo, solo para pruebas con fechas fijas, como la suite de sistema del agente.
# No se usa con la demo: demo-stack corre con el reloj real.
# PAYMENT_SANDBOX_CLOCK_AT=2026-09-10T14:05:00Z
