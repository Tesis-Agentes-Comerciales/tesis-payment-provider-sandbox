PAYMENT_DATABASE_PATH=.local/payments.db
PAYMENT_AGENT_BEARER_TOKEN=replace-with-random-secret-of-at-least-32-characters
PAYMENT_MERCHANT_BEARER_TOKEN=replace-with-another-random-secret-of-at-least-32-characters
PAYMENT_TOKEN_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
PAYMENT_MERCHANT_ID=tesis_merchant
# Verify Payment Mandate before token issuance and sign synthetic Payment Receipt.
# PAYMENT_AP2_REQUIRED=true
# PAYMENT_AP2_AGENT_JWK_JSON={"kty":"EC","crv":"P-256","x":"...","y":"..."}
# PAYMENT_AP2_MERCHANT_JWK_JSON={"kty":"EC","crv":"P-256","x":"...","y":"..."}
# PAYMENT_AP2_MERCHANT_ISSUER=https://merchant.example.test
# PAYMENT_AP2_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Set only when the merchant runs a fixed-clock synthetic episode.
# PAYMENT_SANDBOX_CLOCK_AT=2026-09-10T14:05:00Z
